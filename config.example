# Surge Watchdog configuration
# Do not add spaces around '='.

SURGE_APP_PATH=/Applications/Surge.app
SURGE_PROCESS_NAME=Surge
SURGE_CLI_PATH=/Applications/Surge.app/Contents/Applications/surge-cli

# Gateway VM IP is discovered from Surge's generated server.json on every check.
SURGE_DNS_IP=198.18.0.2
DNS_TEST_NAME=surge-watchdog.invalid

# Enable or disable individual checks with 1 or 0.
CHECK_PROCESS=1
CHECK_GATEWAY_MODE=1
CHECK_DNS=1

# With a 10-second launchd interval, three failures means roughly 30 seconds.
FAILURE_THRESHOLD=3
RESTART_COOLDOWN_SECONDS=120
MAX_RESTARTS_PER_HOUR=3

# Recovery first asks the official Surge CLI to stop the app, then uses a
# graceful SIGTERM only if needed. It never force-kills Surge.
CLI_STOP_TIMEOUT_SECONDS=8
PROCESS_STOP_TIMEOUT_SECONDS=10

# A recovery is successful only after all enabled checks pass again.
RECOVERY_VERIFY_SECONDS=60
RECOVERY_VERIFY_INTERVAL_SECONDS=5

# Native UI Helper requests time out instead of blocking the watchdog forever.
UI_HELPER_TIMEOUT_SECONDS=45

# UI automation is a last resort. Its app is installed in ~/Applications.
# Run --ui-probe successfully before enabling.
ENABLE_UI_FALLBACK=0

# Product app controls these values. Monitoring can be paused without
# uninstalling the LaunchAgent. Daily logs are automatically pruned.
MONITORING_ENABLED=1
LOG_RETENTION_DAYS=7
